---
import Base from '../layouts/Base.astro';
---

<Base title="Download" description="Download Pulse for macOS.">
  <section class="hero container narrow">
    <span class="badge">Coming soon</span>
    <h1>Download Pulse</h1>
    <p class="lede">
      Signed builds aren't available yet. Until then, you can build Pulse from source with
      Xcode.
    </p>
    <div class="actions">
      <a class="button primary" href="https://github.com/marcrdgz/pulse#development">Build from source</a>
      <a class="button" href="https://github.com/marcrdgz/pulse/subscription">Watch for releases</a>
    </div>
    <p class="fine">Requires macOS 14 or later.</p>
  </section>
</Base>
