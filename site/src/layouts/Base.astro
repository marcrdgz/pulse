---
import '@fontsource-variable/caveat';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "A native macOS browser built on WebKit, with Arc's look and keyboard-first workflow.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} · Pulse` : 'Pulse — a native macOS browser';
const repoUrl = 'https://github.com/marcrdgz/pulse';
const ogImage = new URL(`${base}/brand/og-dark.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a class="brand" href={`${base}/`} aria-label="Pulse home">
          <Mark size={24} />
          <Wordmark class="brand-word" />
        </a>
        <div class="nav-links">
          <a href={`${base}/#features`}>Features</a>
          <a href={`${base}/#shortcuts`}>Shortcuts</a>
          <a href={repoUrl}>GitHub</a>
          <a class="nav-download" href={`${base}/download`}>Download</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="footer-brand">
          <Mark variant="mono" size={20} />
          Pulse is free software under the AGPL-3.0.
        </span>
        <a href={repoUrl}>Source on GitHub</a>
      </div>
    </footer>
  </body>
</html>
